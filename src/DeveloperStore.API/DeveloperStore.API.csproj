    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeveloperStore.App\DeveloperStore.App.csproj" />
  </ItemGroup>

</Project>
